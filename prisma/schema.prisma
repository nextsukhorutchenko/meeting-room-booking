generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthRateLimitBucket {
  key             String   @id @db.VarChar(64)
  attempts        Int
  windowStartedAt DateTime @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String
  normalizedEmail    String              @unique
  passwordHash       String
  emailVerifiedAt    DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  verificationTokens VerificationToken[]
  bookings           Booking[]
  notifications      Notification[]
}

model VerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  floor     Int
  capacity  Int
  sortOrder Int
  bookings  Booking[]
}

model Booking {
  id          String    @id @default(cuid())
  roomId      String
  userId      String
  title       String
  startsAt    DateTime  @db.Timestamptz(3)
  endsAt      DateTime  @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  room        Room      @relation(fields: [roomId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  currentNotifications Notification[] @relation("CurrentBooking")
  nextNotifications    Notification[] @relation("NextBooking")

  @@index([roomId, startsAt, endsAt])
  @@index([userId, startsAt])
}

enum NotificationType {
  BOOKING_END_HANDOFF
}

model Notification {
  id               String           @id @default(cuid())
  type             NotificationType
  recipientId      String
  currentBookingId String
  nextBookingId    String
  deliverAt        DateTime         @db.Timestamptz(3)
  leaseExpiresAt   DateTime?        @db.Timestamptz(3)
  acknowledgedAt   DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  recipient        User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  currentBooking   Booking          @relation("CurrentBooking", fields: [currentBookingId], references: [id], onDelete: Cascade)
  nextBooking      Booking          @relation("NextBooking", fields: [nextBookingId], references: [id], onDelete: Cascade)

  @@unique([type, recipientId, currentBookingId, nextBookingId])
  @@index([recipientId, acknowledgedAt, leaseExpiresAt, deliverAt])
}
