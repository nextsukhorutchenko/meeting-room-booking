{
  "name": "meeting-room-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/prepare-standalone.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "tsx scripts/check-design-contrast.ts",
    "check:design-tokens": "tsx scripts/check-design-tokens.ts",
    "check:source": "tsx scripts/check-source-hygiene.ts",
    "test": "vitest run --config vitest.config.ts",
    "pretest": "npm run db:generate",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:unit": "npm run db:generate",
    "test:impact": "vitest run tests/unit/impact-map.test.ts tests/unit/pr-impact-reporter.test.ts tests/unit/playwright-agent-contract.test.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "pretest:coverage": "npm run db:generate",
    "test:integration": "tsx scripts/check-test-database-url.ts integration && vitest run --config vitest.integration.config.ts --no-file-parallelism",
    "test:e2e": "tsx scripts/check-test-database-url.ts e2e && npm run build && tsx scripts/run-e2e.ts",
    "test:e2e:list": "playwright test --config playwright.config.ts --list",
    "test:exploratory": "node -r dotenv/config -e \"const names=['MIDSCENE_MODEL_BASE_URL','MIDSCENE_MODEL_API_KEY','MIDSCENE_MODEL_NAME','MIDSCENE_MODEL_FAMILY'];const missing=names.filter((name)=>!process.env[name]);if(missing.length){console.error('Midscene exploratory tests require: '+missing.join(', '));process.exit(1)}\" && playwright test --config playwright.midscene.config.ts",
    "select:e2e": "tsx scripts/select-impacted-tests.ts",
    "db:generate": "tsx scripts/generate-prisma-client.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx prisma/seed-test.ts",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "verify:clean-start": "tsx scripts/verify-clean-start.ts"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "lucide-react": "^1.27.0",
    "luxon": "^3.7.2",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@midscene/web": "^1.10.7",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/css-tree": "^2.3.11",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "css-tree": "^3.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
